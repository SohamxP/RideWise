<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- MAIN FORM -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="@string/where_to"
        app:titleTextColor="@color/primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Pickup -->
            <AutoCompleteTextView
                android:id="@+id/pickupInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/enter_pickup_location"
                android:drawableLeft="@android:drawable/ic_menu_mylocation"
                android:drawablePadding="10dp"
                android:padding="16dp"
                android:background="@drawable/input_bg"
                android:textColor="@color/primary"
                android:textColorHint="@color/muted"
                android:inputType="text"
                android:completionThreshold="0" />

            <!-- Destination -->
            <AutoCompleteTextView
                android:id="@+id/destinationInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/enter_destination"
                android:drawableLeft="@android:drawable/ic_menu_compass"
                android:drawablePadding="10dp"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_bg"
                android:textColor="@color/primary"
                android:textColorHint="@color/muted"
                android:inputType="text"
                android:completionThreshold="0" />

            <!-- Map Preview Placeholder -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/ic_map_placeholder"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <!-- COMPARE RIDES BUTTON -->
            <Button
                android:id="@+id/compareRidesBtn"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="@string/compare_rides"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>