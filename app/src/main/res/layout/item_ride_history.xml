<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Date and Provider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rideDateTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/october_26_2024"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/rideProviderTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/uber"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/secondary" />
        </LinearLayout>

        <!-- Route -->
        <TextView
            android:id="@+id/rideDetailsTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/from_downtown_to_airport"
            android:textSize="14sp"
            android:textColor="@color/headline" />

        <!-- Price and Savings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ridePriceTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/price_42_50"
                android:textSize="14sp"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/rideSavingsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/saved_6_00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/green" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>