<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background_light"
        app:title="@string/app_name"
        app:titleTextColor="@color/primary" />

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ridewise"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="16dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_ride_comparison"
            android:textSize="18sp"
            android:textColor="@color/muted"
            android:layout_marginBottom="48dp" />

        <!-- Welcome Message -->
        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_back_mark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/headline"
            android:layout_marginBottom="32dp" />

        <!-- Start Ride Button -->
        <Button
            android:id="@+id/startRideBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/find_a_ride"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp" />

        <!-- View History Button -->
        <Button
            android:id="@+id/viewHistoryBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/view_ride_history"
            android:textSize="18sp"
            android:backgroundTint="@color/secondary"
            android:textColor="@color/white" />

        <!-- Features List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compare_uber_lyft_amp_taxis"
                android:textSize="16sp"
                android:textColor="@color/muted"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wait_amp_save_predictions"
                android:textSize="16sp"
                android:textColor="@color/muted"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/walk_nearby_suggestions"
                android:textSize="16sp"
                android:textColor="@color/muted"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_your_savings"
                android:textSize="16sp"
                android:textColor="@color/muted" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>