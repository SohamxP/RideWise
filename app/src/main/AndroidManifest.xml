<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.RideWise"
        tools:targetApi="31">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- 1. LAUNCHER: Auth Screen -->
        <activity
            android:name=".AuthActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Signup Screen -->
        <activity
            android:name=".SignupActivity"
            android:exported="false" />

        <!-- 3. Welcome Screen -->
        <activity
            android:name=".WelcomePageActivity"
            android:exported="false" />

        <!-- 4. Where To Screen -->
        <activity
            android:name=".WhereToActivity"
            android:exported="false" />

        <!-- 5. Trip Compare Screen -->
        <activity
            android:name=".TripCompareActivity"
            android:exported="false" />

        <!-- 6. Wait & Save Screen -->
        <activity
            android:name=".WaitAndSaveActivity"
            android:exported="false" />

        <!-- 7. Walk Nearby Screen -->
        <activity
            android:name=".WalkNearbyActivity"
            android:exported="false" />

        <!-- 8. Savings Dashboard Screen -->
        <activity
            android:name=".SavingsDashboardActivity"
            android:exported="false" />


        <!-- 9. Profile Screen -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- 10. Settings Screen -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

    </application>

</manifest>